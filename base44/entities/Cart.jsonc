{
  "name": "Cart",
  "type": "object",
  "properties": {
    "cart_item_id": {
      "type": "string",
      "title": "Cart Item Id"
    },
    "session_id": {
      "type": "string",
      "title": "Session Id"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "procedure",
        "flight",
        "hotel",
        "travel",
        "insurance",
        "other"
      ]
    },
    "item_name": {
      "type": "string",
      "title": "Item Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "provider": {
      "type": "string",
      "title": "Provider / Hospital / Hotel / Airline"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "title": "Unit Price"
    },
    "total_price": {
      "type": "number",
      "title": "Total Price"
    },
    "metadata": {
      "type": "object",
      "title": "Metadata"
    },
    "date_added": {
      "type": "string",
      "format": "date-time",
      "title": "Date Added"
    }
  },
  "required": [
    "category",
    "item_name",
    "quantity",
    "unit_price"
  ]
}